# ═══════════════════════════════════════════════════════════════════════════════
# Docker Build Exclusions — faster builds, smaller images
# ═══════════════════════════════════════════════════════════════════════════════

# Git repository
.git/
.gitignore
.gitattributes

# Python cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
build/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Documentation and README files
README.md
*.md
docs/
*.txt
!requirements.txt

# CI/CD and testing
.github/
.gitlab-ci.yml
.travis.yml
tests/
test_*/
*_test.py
pytest.ini
.coverage
htmlcov/

# Docker files (prevent recursive copy)
Dockerfile
docker-compose.yml
.dockerignore

# Setup scripts (not needed in container)
its-a-plane-python/setup/

# RGB Matrix library (not needed for web-only container)
rpi-rgb-led-matrix/

# Local environment files (use docker-compose env_file instead)
.env
.env.local

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Data files (use volumes instead)
its-a-plane-python/close.txt
its-a-plane-python/tracked_flight.json
