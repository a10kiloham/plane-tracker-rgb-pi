# ═══════════════════════════════════════════════════════════════════════════════
# Plane Tracker — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# ALL configuration lives here — config.py reads exclusively from env vars.
# No defaults are hardcoded in source code for user-specific values.
#
# Setup:
#   cp .env.example .env
#   nano .env           # Fill in your values
#
# For systemd deployment, install-service.sh copies .env to /etc/plane-tracker.env
# ═══════════════════════════════════════════════════════════════════════════════
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Adafruit Bonnet Type (REQUIRED — replace with your own)                     │
# │ supported types:*triple, single                                             |
# │ if using the triple, make sure you switch the on-board 4-8 DIP switch LEFT  |
# │ or your colors will be out of whack                                         |
# └─────────────────────────────────────────────────────────────────────────────┘
BONNET_TYPE=triple
# PWM on the RGB HAT (True/False) - not applicable for the Triple Bonnet
HAT_PWM_ENABLED=True

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ API Keys (REQUIRED — replace with your own)                                 │
# └─────────────────────────────────────────────────────────────────────────────┘

# FlightRadar24 subscription key and token (format: "subscription_key|token" or 
# just simple "token")
FR24_API_KEY=

# Tomorrow.io weather API key (https://www.tomorrow.io/weather-api/)
TOMORROW_API_KEY=

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Location — Bounding Box (REQUIRED for overhead detection)                   │
# └─────────────────────────────────────────────────────────────────────────────┘
# Use https://www.latlong.net/ or Google Maps to find corners of your area.
# Top-left = north-west corner, Bottom-right = south-east corner.

ZONE_TL_LAT=
ZONE_TL_LON=
ZONE_BR_LAT=
ZONE_BR_LON=

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Home Location (REQUIRED — for distance calculations)                        │
# └─────────────────────────────────────────────────────────────────────────────┘

HOME_LAT=
HOME_LON=

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Weather                                                                     │
# └─────────────────────────────────────────────────────────────────────────────┘

# Comma-separated lat,lon for weather lookups (usually same as HOME_LAT,HOME_LON)
TEMPERATURE_LOCATION=

# Units: "metric" (°C) or "imperial" (°F)
TEMPERATURE_UNITS=metric

# Number of forecast days to display (1-5)
FORECAST_DAYS=3

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Display & Units                                                             │
# └─────────────────────────────────────────────────────────────────────────────┘

# Distance: "metric" (km) or "imperial" (miles)
DISTANCE_UNITS=metric

# Clock: "12hr" or "24hr"
CLOCK_FORMAT=24hr

# LED brightness (0-100)
BRIGHTNESS=100

# Night-mode brightness (0-100, used when NIGHT_BRIGHTNESS=True)
BRIGHTNESS_NIGHT=50

# Enable night dimming? (True/False)
NIGHT_BRIGHTNESS=False

# Night mode time window (HH:MM format)
NIGHT_START=22:00
NIGHT_END=06:00

# GPIO slowdown: 2 for Pi 3/4, 1 for Pi Zero
GPIO_SLOWDOWN=2

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Flight Filtering                                                            │
# └─────────────────────────────────────────────────────────────────────────────┘

# Minimum altitude in feet (filters low GA traffic; 0 = no filter)
MIN_ALTITUDE=0

# Your home airport IATA code (e.g. LHR, ORD, JFK, SFO)
JOURNEY_CODE_SELECTED=

# Filler text shown when journey info is unknown
JOURNEY_BLANK_FILLER= ?

# Speed: "imperial" (mph), "metric" (km/h), or "knots"
SPEED_UNITS=metric

# Search radius in nautical miles from home for aircraft detection.
# If not set, computed from the bounding box (minimum 10nm).
#SEARCH_RADIUS_NM=10

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Flyover Context (optional)                                                  │
# └─────────────────────────────────────────────────────────────────────────────┘
# Enrich the tracked-flight stats line: show a US National Park the aircraft
# is flying over (within 30km), or the ocean/sea name when it is far from any
# city ("nr Grand Canyon", "nr North Atlantic"), instead of always the nearest
# city. Pure local lookups — no API keys or network calls. (True/False)
LANDMARKS_ENABLED=False

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ ISS Overhead Passes (optional)                                              │
# └─────────────────────────────────────────────────────────────────────────────┘
# Show ISS pass alerts ("ISS 3m") and a full-screen takeover while the ISS is
# overhead. Passes are computed locally from CelesTrak TLE data (refreshed at
# most every 12h) using your HOME_LAT/HOME_LON — no extra API key needed.
# Requires the optional `ephem` package (pip install ephem; included in
# requirements.txt). True/False.
ISS_ENABLED=False

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Logging & Notifications                                                     │
# └─────────────────────────────────────────────────────────────────────────────┘

# Email address for alerts (leave empty to disable)
EMAIL=

# Number of farthest/closest flights to track
MAX_FARTHEST=3
MAX_CLOSEST=3

# Days of daily flight-counter history to keep for the stats pages (default 90)
#STATS_LOG_DAYS=90

# systemd service name used by the web UI for the journal log viewer (/logs)
# and the restart button (default "flight-tracker")
#SERVICE_NAME=flight-tracker

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Optional route/schedule enrichment                                          │
# └─────────────────────────────────────────────────────────────────────────────┘
# AirLabs (tracked-flight schedules when not yet live): free, 1000 calls/month
# (https://airlabs.co/)
#AIRLABS_API_KEY=
# Routes come from FR24 gRPC with a free FlightStats fallback — no other keys
# are needed.

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Hourly Chime (optional — needs mpv + a speaker; see setup/systemd/)         │
# └─────────────────────────────────────────────────────────────────────────────┘
# Played by a systemd timer (setup/systemd/README.md), NOT the tracker process.
HOURLY_CHIME_ENABLED=False
HOURLY_CHIME_VOLUME=50
# No chime during this window (overnight ranges supported)
HOURLY_CHIME_QUIET_START=22:00
HOURLY_CHIME_QUIET_END=08:00

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ ATC Radio (optional — live LiveATC.net audio, auto-tuned to overhead       │
# │ traffic; control it at /atc in the web UI or via HomeKit scripts in        │
# │ setup/homebridge/)                                                          │
# └─────────────────────────────────────────────────────────────────────────────┘
# Master switch. Everything below is ignored unless True.
ATC_ENABLED=False

# Initial mode on FIRST run only: auto (follow overhead traffic), manual
# (stay on ATC_STATION), off (wait for an explicit start). Changes made at
# runtime (web UI / HomeKit) persist in the data dir and win thereafter.
#ATC_MODE=auto

# Initial audio output: usb = mpv to a USB speaker on the Pi (needs
# `sudo apt install mpv`); chromecast:<uuid> / airplay:<id> (ids from
# /api/atc/outputs — need the optional pychromecast / pyatv packages, see
# requirements.txt comments); browser = a browser plays the stream itself.
#ATC_OUTPUT=usb

# Initial volume 0-100
#ATC_VOLUME=70

# Auto mode never STARTS audio in this window (an explicit start overrides
# until the window ends). Both blank = use NIGHT_START/NIGHT_END.
#ATC_QUIET_START=22:00
#ATC_QUIET_END=06:00

# Initial LiveATC mount for manual mode, e.g. kjfk_twr (blank = auto-pick)
#ATC_STATION=

# Resume a Pi-side output (usb/cast/airplay) after a service restart
#ATC_AUTO_RESUME=True

# mpv --audio-device override for the USB speaker; blank auto-detects the
# first USB-audio card (e.g. alsa/plughw:CARD=UACDemoV10,DEV=0)
#ATC_USB_DEVICE=

# Extra/corrected LiveATC feeds merged over the built-in seed:
# comma list of ICAO/kind/mount[/lat/lon], kind one of twr|app|ctr
# e.g. ATC_CUSTOM_FEEDS=KFRG/twr/kfrg_twr/40.73/-73.41
#ATC_CUSTOM_FEEDS=

# Port the web app (and its local-only /atc/relay) listens on — 8080 under
# systemd, 6969 in the Docker image. Must match how web/app.py is launched.
#ATC_RELAY_PORT=8080
